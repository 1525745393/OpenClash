    - '+.ip.sb'
    - '+.myip.la'
    - '+.checkip.amazonaws.com'
    - '+.ipinfo.io'
    
    # Steam 相关 (国内直连)
    - '+.steampowered.com'
    - '+.steamcontent.com'
    - '+.steamstatic.com'
    - '+.steamcommunity.com'
    - '+.cm.steampowered.com'
    
    # Nintendo
    - '+.nintendo.net'
    - '+.nintendo.com'
    
    # PlayStation
    - '+.playstation.net'
