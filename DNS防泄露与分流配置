    - '+.riotgames.com'
    - '+.mihoyo.com'
    - '+.hoyoverse.com'
    - '+.bh3.com'
    
    # 国内视频
    - '+.youku.com'
    - '+.iqiyi.com'
    - '+.qq.com'
    - '+.bilibili.com'
    - '+.douyu.com'
    - '+.huya.com'
    - '+.cc.com'
    
    # 国内音乐
