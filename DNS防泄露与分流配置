# ==========================================================
# ==== DNS 防泄露与 DNS 分流配置 ====
# ==========================================================
#
# 生成时间: 2026-06-10
# 参考文档: https://wiki.metacubex.one/config/dns/
#

# ==========================================================
# ==== [General] 插件设置 ====
# ==========================================================

# DNS 重定向模式
# 0: 禁用
# 1: Dnsmasq Redirect (推荐路由器)
# 2: Firewall Redirect
ENABLE_REDIRECT_DNS = 1

# 启用自定义 DNS
ENABLE_CUSTOM_DNS = 1

# Fake-IP 过滤模式
# blacklist: 黑名单模式 (推荐)
# whitelist: 白名单模式
CUSTOM_FAKEIP_FILTER = 1
CUSTOM_FAKEIP_FILTER_MODE = blacklist

# 自定义 Fake-IP 地址段
FAKEIP_RANGE = 198.18.0.1/16

# DNS 遵循规则
ENABLE_RESPECT_RULES = 1

# 自定义 Nameserver-Policy
CUSTOM_NAME_POLICY = 1

# 自定义 Hosts
CUSTOM_HOST = 1

# 自定义 Fallback-Filter
CUSTOM_FALLBACK_FILTER = 1

# ==========================================================
# ==== [YAML] DNS 详细配置 ====
# ==========================================================

[YAML]

# ----------------------------------------------------------
# 1. 完整的 DNS 防泄露 + 分流配置
# ----------------------------------------------------------

# DNS 服务器配置
dns:
  # 启用 DNS 服务
  enable: true
  
  # DNS 监听地址
  listen: 0.0.0.0:7874
  
  # IPv6 支持 (国内建议关闭)
  ipv6: false
  
  # DNS 运行模式
  # fake-ip: DNS欺骗，返回虚假IP (推荐)
  # redir-host: 重定向模式，返回真实IP
  enhanced-mode: fake-ip
  
  # Fake-IP 地址池
  fake-ip-range: 198.18.0.1/16
  
  # Fake-IP 过滤器 (黑名单模式)
  # 匹配的域名不使用 Fake-IP，直接解析
  fake-ip-filter-mode: blacklist
  
  fake-ip-filter:
    # 局域网域名
    - '+.lan'
    - '+.local'
    - '+.localhost'
    
    # 国内常见域名
    - '+.cn'
    - '+.baidu.com'
    - '+.qq.com'
    - '+.taobao.com'
    - '+.jd.com'
    - '+.alipay.com'
    - '+.tmall.com'
    - '+.163.com'
    - '+.126.com'
    - '+.sina.com'
    - '+.weibo.com'
    - '+.bilibili.com'
    - '+.douyin.com'
    - '+.toutiao.com'
    - '+.zhihu.com'
    - '+.csdn.net'
    - '+.gitee.com'
    - '+.oschina.net'
    
    # 国内银行和支付
    - '+.icbc.com.cn'
    - '+.ccb.com.cn'
    - '+.boc.cn'
    - '+.abchina.com'
    - '+.cmbchina.com'
    - '+.pingan.com'
    - '+.alipay.com'
    
    # 路由器管理界面
